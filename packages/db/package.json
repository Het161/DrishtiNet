{
  "name": "@drishtinet/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./spatial": "./src/spatial.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && tsx src/post-migrate.ts",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force && tsx src/post-migrate.ts",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@drishtinet/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

# DrishtiNet — copy to .env and adjust. NEVER commit .env.
# Everything below is a LOCAL service. No cloud, no external network at demo time.

# ---------- Postgres + PostGIS ----------
# Default is the canonical upstream image (amd64 only). On Apple Silicon / ARM, uncomment the
# multi-arch community rebuild below to run native instead of under QEMU emulation:
#   POSTGRES_IMAGE=imresamu/postgis:16-3.4
POSTGRES_IMAGE=postgis/postgis:16-3.4
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_dev_only
POSTGRES_DB=drishtinet
POSTGRES_PORT=5433
# Used by Prisma / services. Inside docker-compose the host is `postgres`.
DATABASE_URL=postgresql://drishti:drishti_dev_only@localhost:5433/drishtinet?schema=public

# ---------- Redis (event bus: Redis Streams) ----------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ---------- MinIO (evidence clips, S3-compatible) ----------
MINIO_ROOT_USER=drishti
MINIO_ROOT_PASSWORD=drishti_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=drishtinet-evidence
S3_ACCESS_KEY=drishti
S3_SECRET_KEY=drishti_dev_only

# ---------- MediaMTX (stream gateway) ----------
MEDIAMTX_API_PORT=9997
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
STREAM_GATEWAY_PORT=4001

# ---------- Services ----------
ANALYTICS_PORT=8001
ALERTS_PORT=4002
INTEGRATIONS_PORT=4003
WEB_PORT=3000

# ---------- Web (public = shipped to browser) ----------
NEXT_PUBLIC_ALERTS_WS_URL=ws://localhost:4002/ws
NEXT_PUBLIC_STREAM_GATEWAY_URL=http://localhost:4001
NEXT_PUBLIC_WEBRTC_BASE_URL=http://localhost:8889
NEXT_PUBLIC_MAP_STYLE_URL=/map/style.json
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---------- Auth ----------
# Dev-only signing key. Rotate for any non-local use.
AUTH_SECRET=change-me-32-bytes-minimum-for-hs256-dev
AUTH_SESSION_TTL_HOURS=12

# ---------- Analytics tuning ----------
# CPU-only demo laptops: keep these low. GPU box: raise ANALYTICS_MAX_STREAMS.
ANALYTICS_DEVICE=cpu
ANALYTICS_SAMPLE_FPS=3
ANALYTICS_MAX_STREAMS=6
ANALYTICS_MOTION_GATE=true
ANALYTICS_DETECTOR_MODEL=yolo11n
ANALYTICS_PLATE_MIN_CONF=0.45

# ---------- Workspace: keep every cache and model inside the repo ----------
# Nothing may be written to $HOME. Docker compose and the Makefile export these too.
PIP_CACHE_DIR=./.cache/pip
npm_config_cache=./.cache/npm
YOLO_CONFIG_DIR=./.cache/ultralytics
TORCH_HOME=./.cache/torch
HF_HOME=./.cache/huggingface
EASYOCR_MODULE_PATH=./.cache/easyocr
# Ultralytics weights are loaded from here by explicit path, never auto-downloaded to $HOME.
MODEL_DIR=./models
PADDLE_MODEL_DIR=./models/paddle

# ---------- Upstream portal (shared government infrastructure — be polite) ----------
SENTINEL_BASE=https://live.sentinelgujarat.in
# The caching range proxy. Required in practice: ffmpeg's un-ranged GET against the portal
# frequently returns an empty body, so deep seeks (the daylight window) fail without it.
RANGE_PROXY_PORT=4010
RANGE_PROXY_URL=http://127.0.0.1:4010
RANGE_PROXY_CACHE_MAX=1G
MIRROR_RATE_LIMIT=2M
# Minimum intervals, per CLAUDE.md.
REGISTRY_POLL_INTERVAL_S=60
SNAPSHOT_MIN_INTERVAL_S=2
UPSTREAM_IDLE_TIMEOUT_S=60

# ---------- Demo ----------
DEMO_MODE=true
DEMO_DESIGNATED_PLATE=GJ01AB1234
TZ=Asia/Kolkata

# VIRTUAL_NOW_IST — the single demo time-shift, read by every component.
# The provided footage spans 21:00 -> 09:00, so a working-hours demo shows deep-night video with
# unreadable plates. Set this to an ISO-8601 instant inside a daylight window to run the demo on
# daylight footage. When set, the UI shows a "TIME-SHIFT (demo)" banner and audit_log records it.
# Daylight windows: recorded 06:00-09:00 (offsets 32400-43200).
# Example: VIRTUAL_NOW_IST=2026-08-21T07:15:00+05:30
VIRTUAL_NOW_IST=
